{
  "name": "@tracklane/sync-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-agnostic local-first sync engine: object pool, optimistic transaction queue, rebaser, IndexedDB persistence and cross-tab coordination.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./socket-io": {
      "types": "./dist/socket-io-transport.d.ts",
      "default": "./dist/socket-io-transport.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tracklane/domain": "workspace:*",
    "idb": "^8.0.3",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "vitest": "^5.0.3",
    "socket.io-client": "^4.8.4"
  },
  "peerDependencies": {
    "socket.io-client": "^4.8.0"
  },
  "peerDependenciesMeta": {
    "socket.io-client": {
      "optional": true
    }
  }
}
