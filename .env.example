# API (apps/server)
NODE_ENV=development
PORT=8110
MONGO_URL=mongodb://127.0.0.1:27110/tracklane?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6410
# Generate with: openssl rand -base64 48. The server refuses this example value when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
JWT_TTL_SECONDS=86400
CORS_ORIGIN=http://localhost:3110,http://127.0.0.1:3110
LOG_LEVEL=info
SYNC_LOG_RETENTION_DAYS=14
CATCHUP_MAX_DELTAS=5000
PRESENCE_TTL_SECONDS=30
# How often live sockets re-check team membership.
ACCESS_REFRESH_SECONDS=60
# Attempts per IP and per email within the window. The server defaults to 10; local
# development and the Playwright suite sign in far more often than a person would.
LOGIN_RATE_LIMIT=100
LOGIN_RATE_WINDOW_SECONDS=60
# Lists the demo workspace's accounts on the sign-in screen. Off unless set.
DEMO_MODE=true
DEMO_WORKSPACE_SLUG=lumen
# Reverse proxies in front of the API (0 = none). Only set this behind a proxy
# that overwrites X-Forwarded-For, or clients can pick their own rate-limit IP.
TRUST_PROXY_HOPS=0

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8110
